# 复制成 .env 后按需修改；所有值都有默认值，不改也能直接启动。
#     cp .env.example .env

# ---------- 站点 ----------
SITE_URL=http://localhost:3000
SITE_NAME=
SITE_TAGLINE=
SITE_DESCRIPTION=

# ---------- 端口 ----------
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5433

# ---------- 数据库 ----------
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=beichuang
# 生产环境请务必改成强密码，并且只在宿主机内网暴露 5433

# ---------- 跨域 ----------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- 运行环境 ----------
APP_ENV=production

# ---------- 管理后台 ----------
# 首次启动（admin_users 表为空）时，用下面这组账号创建初始管理员，之后可改。
# 生产环境务必修改 ADMIN_PASSWORD 和 ADMIN_SECRET！
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# 登录 token 的 HMAC 签名密钥，务必改成随机长字符串
ADMIN_SECRET=change-me-in-production
